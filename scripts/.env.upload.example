# Store upload credentials for scripts/upload.mjs (SPEC-076 / ARCH-029).
#
# Copy this file to scripts/.env.upload and fill in the values. That file is
# gitignored, so it never lands in the repo. Real environment variables
# exported in your shell always take precedence over this file.

# Apple App Store Connect — Transporter CLI (xcrun iTMSTransporter)
# App-specific password: appleid.apple.com → Sign-In & Security → App-Specific Passwords
LP_APPLE_ID=you@example.com
LP_APPLE_APP_SPECIFIC_PASS=xxxx-xxxx-xxxx-xxxx

# Only needed if the Apple ID belongs to multiple App Store Connect teams.
# Find your provider short name: iTMSTransporter -m provider -u <id> -p <pass>
# Language Player 3's team is 9CS9PCBX32 (matches DEVELOPMENT_TEAM in SPEC-048).
LP_APPLE_ITC_PROVIDER=9CS9PCBX32

# App Store Connect API key — for automated version creation + review submission
# (node scripts/upload.mjs appstore prepare|submit). Generate:
# App Store Connect → Users and Access → Integrations → App Store Connect API
LP_ASC_KEY_PATH=/absolute/path/to/AuthKey_XXXXXX.p8
LP_ASC_KEY_ID=XXXXXXXXXX
LP_ASC_ISSUER_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# Optional overrides (defaults are correct for Language Player 3):
# LP_ASC_APP_ID=6520385296
# LP_ASC_DEMO_EMAIL=tester.mary@zerotohero.ca
# LP_ASC_DEMO_PASS=pc8qm8LBZeGuBno
# LP_ASC_CONTACT_EMAIL=jon.long@zerotohero.ca

# Google Play — service-account JSON key
# One-time setup: Play Console → Setup → API access (see docs/specs/067 §4.5)
# You may keep the JSON inside the repo at scripts/lp-play-service-account.json
# (gitignored) or outside the repo (e.g. ~/.config/lp-play-service-account.json).
LP_PLAY_SERVICE_ACCOUNT_JSON=/absolute/path/to/lp-play-service-account.json

# Optional — defaults to ca.zerotohero.go
LP_PLAY_PACKAGE=ca.zerotohero.go

# Chrome Web Store — service-account JSON (same account as Play works if it is
# linked under Developer Dashboard → Settings → Service account; only one is
# allowed per publisher). Defaults to LP_PLAY_SERVICE_ACCOUNT_JSON above.
# LP_CWS_SERVICE_ACCOUNT_JSON=/absolute/path/to/cws-service-account.json
# Optional — defaults match the Language Player store item:
# LP_CWS_PUBLISHER_ID=650ad6b1-a9d4-43b6-9ff5-a8ae11ada6ad
# LP_CWS_ITEM_ID=cbkhenammkocfidciagbbibkleoenbej
