{
  "name": "language-player",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "!apps/mobile-go-legacy"
  ],
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "test": "vitest run",
    "test:tokenizer-mobile": "vitest run --config vitest.mobile.config.ts",
    "test:redirects": "node scripts/check-redirects.mjs",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "clean": "turbo clean",
    "typecheck": "turbo typecheck",
    "typecheck:watch": "tsc --watch --noEmit --project apps/web/tsconfig.json",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/papaparse": "^5.5.2",
    "@types/spark-md5": "^3.0.5",
    "expo-router": "~57.0.8",
    "next": "^16.3.0",
    "prettier": "^3.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "turbo": "^2.3.0",
    "typescript": "^5.5.0",
    "vitest": "^2.1.9"
  },
  "packageManager": "npm@10.7.0",
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4"
  },
  "dependencies": {
    "opencc-js": "^1.4.1",
    "papaparse": "^5.5.4",
    "spark-md5": "^3.0.2"
  }
}
