  "mailer_subjects_identity_unlinked_notification": "A sign-in method was removed from your account",
  "mailer_templates_confirmation_content": "<!DOCTYPE html>\n<html lang=\"en\" dir=\"ltr\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <meta name=\"x-apple-disable-message-reformatting\">\n  <title>Confirm your Language Player email</title>\n</head>\n<body style=\"margin:0;padding:0;background-color:#f4f6fb;\">\n  <div role=\"article\" aria-roledescription=\"email\" lang=\"en\" dir=\"ltr\" style=\"background-color:#f4f6fb;padding:32px 16px;\">\n    <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" bgcolor=\"#f4f6fb\">\n      <tr>\n        <td align=\"center\">\n          <!-- Outer card: 600px on desktop, full width on mobile -->\n          <table role=\"presentation\" width=\"600\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" bgcolor=\"#ffffff\" style=\"width:100%;max-width:600px;border-radius:16px;overflow:hidden;box-shadow:0 10px 30px rgba(15,23,42,0.08);\">\n            <!-- Logo -->\n            <tr>\n              <td align=\"center\" style=\"padding:40px 32px 8px 32px;\">\n                <!-- Replace with your hosted logo URL if you prefer a different host. -->\n                <img\n                  src=\"https://language-player.netlify.app/_next/image?url=%2Fimg%2Flogo.png&w=64&q=75\"\n                  width=\"72\"\n                  height=\"72\"\n                  alt=\"Language Player\"\n                  style=\"display:block;width:72px;height:72px;border:0;border-radius:50%;\"\n                >\n              </td>\n            </tr>\n\n            <!-- Heading -->\n            <tr>\n              <td align=\"center\" style=\"padding:16px 32px 8px 32px;\">\n                <h1 style=\"margin:0;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:26px;line-height:1.3;font-weight:700;color:#0f1729;\">\n                  Confirm your email\n                </h1>\n              </td>\n            </tr>\n\n            <!-- Intro -->\n            <tr>\n              <td align=\"center\" style=\"padding:0 40px 8px 40px;\">\n                <p style=\"margin:0;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:16px;line-height:1.6;color:#657386;\">\n                  Welcome to Language Player! You're one step away from learning\n                  with authentic videos and interactive dual subtitles in 60+ languages.\n                </p>\n              </td>\n            </tr>\n\n            <!-- Primary button -->\n            <tr>\n              <td align=\"center\" style=\"padding:24px 40px 8px 40px;\">\n                <a\n                  href=\"{{ .ConfirmationURL }}\"\n                  style=\"display:inline-block;background-color:#69279c;color:#ffffff;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:16px;font-weight:600;line-height:1;text-decoration:none;padding:16px 32px;border-radius:10px;\"\n                >\n                  Confirm email address\n                </a>\n              </td>\n            </tr>\n\n            <!-- Divider -->\n            <tr>\n              <td align=\"center\" style=\"padding:28px 40px 4px 40px;\">\n                <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\">\n                  <tr>\n                    <td style=\"border-bottom:1px solid #e8ecf5;font-size:0;line-height:0;\">&nbsp;</td>\n                  </tr>\n                </table>\n              </td>\n            </tr>\n\n            <!-- Code fallback -->\n            <tr>\n              <td align=\"center\" style=\"padding:20px 40px 4px 40px;\">\n                <p style=\"margin:0;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:14px;line-height:1.5;color:#657386;\">\n                  Prefer to enter a code instead? Use this one on the verification screen:\n                </p>\n              </td>\n            </tr>\n            <tr>\n              <td align=\"center\" style=\"padding:8px 40px 0 40px;\">\n                <table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" bgcolor=\"#f4f6fb\" style=\"background-color:#f4f6fb;border:1px dashed #b9c4d6;border-radius:10px;\">\n                  <tr>\n                    <td align=\"center\" style=\"padding:14px 28px;font-family:'SF Mono',SFMono-Regular,Menlo,Consolas,'Liberation Mono',monospace;font-size:28px;font-weight:700;letter-spacing:8px;color:#0f1729;\">\n                      {{ .Token }}\n                    </td>\n                  </tr>\n                </table>\n              </td>\n            </tr>\n            <tr>\n              <td align=\"center\" style=\"padding:16px 40px 8px 40px;\">\n                <p style=\"margin:0;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:14px;line-height:1.5;color:#657386;\">\n                  The link and code are single-use and expire after a short time.\n                </p>\n              </td>\n            </tr>\n\n            <!-- Ignore notice -->\n            <tr>\n              <td align=\"center\" style=\"padding:8px 40px 32px 40px;\">\n                <p style=\"margin:0;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:13px;line-height:1.5;color:#657386;\">\n                  If you didn't create a Language Player account, you can safely ignore this email.\n                </p>\n              </td>\n            </tr>\n\n            <!-- Footer -->\n            <tr>\n              <td align=\"center\" bgcolor=\"#f8fafc\" style=\"background-color:#f8fafc;border-top:1px solid #e8ecf5;padding:24px 32px;\">\n                <p style=\"margin:0;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:15px;font-weight:600;color:#0f1729;\">\n                  Language Player\n                </p>\n                <p style=\"margin:4px 0 0 0;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:13px;line-height:1.5;color:#657386;\">\n                  Learn languages with authentic video &amp; dual subtitles.\n                </p>\n                <p style=\"margin:8px 0 0 0;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:13px;\">\n                  <a href=\"https://languageplayer.io\" style=\"color:#69279c;text-decoration:none;\">languageplayer.io</a>\n                </p>\n              </td>\n            </tr>\n          </table>\n        </td>\n      </tr>\n    </table>\n  </div>\n</body>\n</html>",
  "mailer_templates_email_change_content": "<h2>Confirm your new email address</h2>\n\n<p>Follow the link below to confirm {{ .NewEmail }} as your new email address.</p>\n<p><a href=\"{{ .ConfirmationURL }}\">Confirm new email address</a></p>\n\n<p>If you didn't request this change, you can safely ignore this email.</p>",
  "mailer_templates_invite_content": "<h2>You've been invited</h2>\n\n<p>You've been invited to create an account. Follow the link below to accept.</p>\n<p><a href=\"{{ .ConfirmationURL }}\">Accept invitation</a></p>",
  "mailer_templates_magic_link_content": "<h2>Your sign-in link</h2>\n\n<p>Follow the link below to sign in. This link expires shortly and can only be used once.</p>\n<p><a href=\"{{ .ConfirmationURL }}\">Sign in</a></p>",
  "mailer_templates_reauthentication_content": "<h2>Your verification code</h2>\n\n<p>Use the code below to verify your identity. It expires shortly.</p>\n\n<p>{{ .Token }}</p>",
  "mailer_templates_recovery_content": "<h2>Reset your password</h2>\n\n<p>We received a request to reset your password. Follow the link below to choose a new one.</p>\n<p><a href=\"{{ .ConfirmationURL }}\">Reset password</a></p>\n\n<p>If you didn't request this, you can safely ignore this email.</p>",
  "mailer_templates_password_changed_notification_content": "<h2>Your password was changed</h2>\n\n<p>The password for your account was recently changed.</p>\n\n<p>If you didn't make this change, reset your password and contact support immediately.</p>",
  "mailer_templates_email_changed_notification_content": "<h2>Your email address was changed</h2>\n\n<p>The email address for your account was changed from {{ .OldEmail }} to {{ .Email }}.</p>\n\n<p>If you didn't make this change, contact support immediately.</p>",
  "mailer_templates_phone_changed_notification_content": "<h2>Your phone number was changed</h2>\n\n<p>The phone number for your account was changed from {{ .OldPhone }} to {{ .Phone }}.</p>\n\n<p>If you didn't make this change, contact support immediately.</p>",
  "mailer_templates_mfa_factor_enrolled_notification_content": "<h2>A new verification method was added</h2>\n\n<p>Sign-in verification method {{ .FactorType }} was added to your account.</p>\n\n<p>If you didn't make this change, contact support immediately.</p>",
  "mailer_templates_mfa_factor_unenrolled_notification_content": "<h2>A verification method was removed</h2>\n\n<p>Sign-in verification method {{ .FactorType }} was removed from your account.</p>\n\n<p>If you didn't make this change, contact support immediately.</p>",
  "mailer_templates_identity_linked_notification_content": "<h2>A new sign-in method was linked</h2>\n\n<p>Your {{ .Provider }} account was linked as a new sign-in method for {{ .Email }}.</p>\n\n<p>If you didn't make this change, contact support immediately.</p>",
  "mailer_templates_identity_unlinked_notification_content": "<h2>A sign-in method was removed</h2>\n\n<p>Your {{ .Provider }} account was removed as a sign-in method for {{ .Email }}.</p>\n\n<p>If you didn't make this change, contact support immediately.</p>",
  "mailer_notifications_password_changed_enabled": false,
  "mailer_notifications_email_changed_enabled": false,
