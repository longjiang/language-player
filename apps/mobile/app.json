{
  "expo": {
    "name": "Language Player 3",
    "slug": "language-player",
    "version": "3.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "scheme": "languageplayer",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1b1e3c"
    },
        "ios": {
            "supportsTablet": true,
            "bundleIdentifier": "ca.zerotohero.go",
            "associatedDomains": [
              "applinks:languageplayer.io",
              "applinks:language-player.netlify.app"
            ]
        },
    "android": {
      "versionCode": 2,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1b1e3c"
      },
      "package": "ca.zerotohero.go",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            { "scheme": "https", "host": "languageplayer.io", "pathPrefix": "/" }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        },
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            { "scheme": "https", "host": "language-player.netlify.app", "pathPrefix": "/" }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      "expo-localization",
      "expo-video",
      "expo-sharing",
      "expo-sqlite",
      "expo-splash-screen",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
