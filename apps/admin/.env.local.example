# Python/Flask backend (local default: http://127.0.0.1:5001)
NEXT_PUBLIC_API_URL=http://127.0.0.1:5001

# NextAuth v5 (Auth.js) — v5 uses AUTH_ prefix
AUTH_URL=http://localhost:3100
AUTH_SECRET=change-me-to-a-random-string-at-least-32-chars

# Optional: 0=off, 1=errors, 2=warnings, 3=verbose
NEXT_PUBLIC_LOG_LEVEL=3
